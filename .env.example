# ─── Database ─────────────────────────────────────────────
# For development: leave blank to use SQLite (localaudit.db)
# For production: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=

# ─── Security ─────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme-generate-a-real-secret

# ─── Anthropic (Claude) ───────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Gmail SMTP (for sending outreach emails) ─────────────
# Use an App Password: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ─── App ──────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
